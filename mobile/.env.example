# Where the app sends /api requests.
#
# Deployed builds need nothing here: the web build calls its own origin and
# native falls back to the production URL baked into src/lib/api.ts.
#
# Local development does need it, because `expo start` serves no API. Copy this
# file to .env and point it at the deployed backend (or a `vercel dev` server).
EXPO_PUBLIC_API_BASE_URL=https://flip-fox.vercel.app
