DEEPL_API_KEY=
DEEPL_API_URL=https://api-free.deepl.com
# Optional: route YouTube caption fetches through a proxy (http://user:pass@host:port).
# Needed on hosts like Vercel, where YouTube rate-limits/blocks datacenter IPs.
YOUTUBE_PROXY_URL=

# Локальное управление проектом через Telegram.
# Создайте бота через @BotFather и никому не отправляйте его токен.
TELEGRAM_BOT_TOKEN=
# Один или несколько числовых Telegram ID через запятую.
TELEGRAM_ALLOWED_USER_IDS=
# Необязательно: модель для задач из Telegram. Пусто = модель по умолчанию Codex CLI.
TELEGRAM_CODEX_MODEL=
